# ==============================================================================
# AgriShield Parametric - Monorepo Environment Variables Example
# Duplicate this file to .env and adjust variables for your local setup.
# ==============================================================================

# ------------------------------------------------------------------------------
# PostgreSQL Database Configuration (Local Docker or Native)
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password
POSTGRES_DB=agrishield_db
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# Prisma Database Connection URL
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://postgres:postgres_secure_password@localhost:5432/agrishield_db?schema=public

# ------------------------------------------------------------------------------
# Backend Service (Node.js / Express / TypeScript)
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development
API_VERSION=v1
CORS_ORIGIN=http://localhost:5173

# Security & Authentication (Architecture placeholders for future modules)
JWT_SECRET=your_jwt_super_secret_key_change_in_production
JWT_EXPIRES_IN=1d

# Inter-Service Communication: ML Service Base URL
ML_SERVICE_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# Frontend Application (React / Vite)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:5000/api/v1
VITE_APP_TITLE=AgriShield Parametric

# ------------------------------------------------------------------------------
# ML Service (Python / FastAPI)
# ------------------------------------------------------------------------------
ML_SERVICE_PORT=8000
ML_SERVICE_HOST=0.0.0.0
ML_ENVIRONMENT=development
ML_CORS_ORIGINS=http://localhost:5000,http://localhost:5173
