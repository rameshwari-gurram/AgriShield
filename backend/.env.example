# Server Configuration
PORT=5000
NODE_ENV=development
API_VERSION=v1

# Security & CORS
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=your_super_secret_jwt_key_replace_in_production
JWT_EXPIRES_IN=1d

# Database Connection (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres_secure_password@localhost:5432/agrishield_db?schema=public

# External Services & APIs
ML_SERVICE_URL=http://localhost:8000
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast

# Module 7: Copernicus Data Space Ecosystem (Sentinel Hub API)
# Credentials belong only in backend environment configuration (never frontend)
COPERNICUS_CLIENT_ID=your_copernicus_client_id
COPERNICUS_CLIENT_SECRET=your_copernicus_client_secret
COPERNICUS_AUTH_URL=https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token
COPERNICUS_BASE_URL=https://sh.dataspace.copernicus.eu
SATELLITE_REQUEST_TIMEOUT_MS=15000

# Email Delivery Configuration (Gmail SMTP / Nodemailer)
# Never commit real credentials to Git. Use a 16-character Google App Password.
EMAIL_ENABLED=false
EMAIL_PROVIDER=gmail
EMAIL_USER=
EMAIL_APP_PASSWORD=
EMAIL_FROM=AgriShield Notifications <no-reply@agrishield.com>

# Administrative Authentication (Stage 1)
# Generate a bcrypt hash for the administrative password:
# node -e "console.log(require('bcryptjs').hashSync('YOUR_STRONG_PASSWORD', 10))"
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
ADMIN_EMAIL=
ADMIN_ID=
ADMIN_FULL_NAME=
