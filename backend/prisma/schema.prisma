// AgriShield Parametric - Prisma Schema
// Module 3: Farm Management Domain

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Language {
  en // English
  hi // Hindi
  mr // Marathi
  te // Telugu
  ta // Tamil
  kn // Kannada
  gu // Gujarati
  bn // Bengali
  pa // Punjabi
}

enum AreaUnit {
  ACRE
  HECTARE
  BIGHA
  GUNTHA
}

enum FarmStatus {
  ACTIVE
  INACTIVE
  HARVESTED
}

model Farmer {
  id                    String    @id @default(uuid()) @db.Uuid
  fullName              String    @db.VarChar(100)
  mobileNumber          String    @unique @db.VarChar(15)
  preferredLanguage     Language  @default(en)
  farmerReferenceNumber String?   @unique @db.VarChar(50)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // Relationships
  farms                 Farm[]
  policies              Policy[]

  @@index([farmerReferenceNumber])
  @@map("farmers")
}

model Farm {
  id                  String      @id @default(uuid()) @db.Uuid
  farmerId            String      @db.Uuid
  farmName            String      @db.VarChar(100)
  farmReferenceNumber String      @unique @db.VarChar(50)
  cropName            String      @db.VarChar(100)
  cropVariety         String?     @db.VarChar(100)
  sowingDate          DateTime    @db.Date
  expectedHarvestDate DateTime?   @db.Date
  farmArea            Decimal     @db.Decimal(10, 2)
  farmAreaUnit        AreaUnit    @default(ACRE)
  village             String      @db.VarChar(100)
  district            String      @db.VarChar(100)
  state               String      @db.VarChar(100)
  pincode             String      @db.VarChar(6)
  status              FarmStatus  @default(ACTIVE)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  // Relationships
  farmer              Farmer         @relation(fields: [farmerId], references: [id], onDelete: Restrict)
  boundary            FarmBoundary?
  weatherRecords      WeatherRecord[]
  riskAssessments     RiskAssessment[]
  satelliteObservations SatelliteObservation[]
  ndviObservations      NdviObservation[]
  mlRiskPredictions     MlRiskPrediction[]
  policies              Policy[]

  @@index([farmerId])
  @@index([cropName])
  @@index([state, district])
  @@map("farms")
}

model FarmBoundary {
  id                     String      @id @default(uuid()) @db.Uuid
  farmId                 String      @unique @db.Uuid
  geom                   Unsupported("geometry(Polygon, 4326)")
  calculatedAreaSqM      Decimal     @db.Decimal(14, 2)
  calculatedAreaHectares Decimal     @db.Decimal(10, 4)
  calculatedAreaAcres    Decimal     @db.Decimal(10, 4)
  centroidLatitude       Decimal     @db.Decimal(9, 6)
  centroidLongitude      Decimal     @db.Decimal(9, 6)
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt

  // Relationships
  farm                   Farm        @relation(fields: [farmId], references: [id], onDelete: Cascade)

  @@index([geom], type: Gist)
  @@map("farm_boundaries")
}

model WeatherRecord {
  id              String      @id @default(uuid()) @db.Uuid
  farmId          String      @db.Uuid
  observedAt      DateTime    @db.Timestamptz(6)
  latitude        Decimal     @db.Decimal(9, 6)
  longitude       Decimal     @db.Decimal(9, 6)
  temperatureC    Decimal     @db.Decimal(5, 2)
  humidityPercent Decimal     @db.Decimal(5, 2)
  rainfallMm      Decimal     @db.Decimal(7, 2)
  windSpeedKmh    Decimal     @db.Decimal(6, 2)
  windGustKmh     Decimal     @db.Decimal(6, 2)
  weatherCode     Int         @db.Integer
  source          String      @db.VarChar(50)
  createdAt       DateTime    @default(now())

  farm            Farm        @relation(fields: [farmId], references: [id], onDelete: Cascade)

  @@unique([farmId, observedAt], name: "farm_observation_unique")
  @@index([farmId, observedAt(sort: Desc)])
  @@map("weather_records")
}

// ============================================================================
// Module 6: Climate Risk Database and Rule Configuration
// ============================================================================

enum RiskSeverity {
  LOW
  MODERATE
  HIGH
  VERY_HIGH
}

enum RiskLevel {
  LOW
  MODERATE
  HIGH
}

enum RiskSourceType {
  OFFICIAL_REFERENCE
  PROJECT_INDICATOR
}

enum RiskHazardType {
  HEAVY_RAINFALL
  INTENSE_RAINFALL
  HIGH_TEMPERATURE
  STRONG_WIND
}

enum RiskMeasurement {
  RAINFALL
  TEMPERATURE
  WIND_SPEED
  WIND_GUST
}

model RiskRule {
  id                String          @id @default(uuid()) @db.Uuid
  code              String          @unique @db.VarChar(50)
  name              String          @db.VarChar(100)
  description       String?         @db.Text
  hazardType        RiskHazardType
  measurement       RiskMeasurement
  threshold         Decimal         @db.Decimal(10, 2)
  thresholdUnit     String          @db.VarChar(20)
  observationWindow String          @db.VarChar(50)
  severity          RiskSeverity
  sourceType        RiskSourceType  @default(OFFICIAL_REFERENCE)
  sourceReference   String          @db.Text
  isActive          Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  // Relationships
  riskEvents        RiskEvent[]

  @@index([hazardType])
  @@index([isActive])
  @@map("risk_rules")
}

model RiskAssessment {
  id                 String          @id @default(uuid()) @db.Uuid
  farmId             String          @db.Uuid
  assessedAt         DateTime        @default(now()) @db.Timestamptz(6)
  overallRisk        RiskLevel
  assessmentVersion  String          @default("1.0.0") @db.VarChar(20)
  ruleCount          Int             @db.Integer
  triggeredRuleCount Int             @db.Integer
  weatherRecordCount Int             @db.Integer
  createdAt          DateTime        @default(now())

  // Relationships
  farm               Farm            @relation(fields: [farmId], references: [id], onDelete: Cascade)
  riskEvents         RiskEvent[]
  claims             Claim[]

  @@index([farmId, assessedAt(sort: Desc)])
  @@index([overallRisk])
  @@map("risk_assessments")
}

model RiskEvent {
  id             String         @id @default(uuid()) @db.Uuid
  assessmentId   String         @db.Uuid
  riskRuleId     String         @db.Uuid
  observedValue  Decimal?       @db.Decimal(10, 2)
  thresholdValue Decimal        @db.Decimal(10, 2)
  unit           String         @db.VarChar(20)
  severity       RiskSeverity
  triggered      Boolean
  explanation    String         @db.Text
  observedAt     DateTime       @db.Timestamptz(6)
  createdAt      DateTime       @default(now())

  // Relationships
  assessment     RiskAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  riskRule       RiskRule       @relation(fields: [riskRuleId], references: [id], onDelete: Restrict)
  claims         Claim[]

  @@index([assessmentId])
  @@index([riskRuleId])
  @@index([triggered])
  @@map("risk_events")
}

// ============================================================================
// Module 7: Satellite Data and Vegetation Index (NDVI) Domain
// ============================================================================

model SatelliteObservation {
  id              String           @id @default(uuid()) @db.Uuid
  farmId          String           @db.Uuid
  observedAt      DateTime         @db.Timestamptz(6)
  provider        String           @db.VarChar(50)
  satellite       String           @db.VarChar(50)
  productType     String           @db.VarChar(50)
  productId       String           @db.VarChar(150)
  cloudCoverage   Decimal?         @db.Decimal(5, 2)
  sourceReference String?          @db.Text
  createdAt       DateTime         @default(now())

  // Relationships
  farm            Farm             @relation(fields: [farmId], references: [id], onDelete: Cascade)
  ndviObservation NdviObservation?

  @@unique([farmId, productId], name: "farm_satellite_product_unique")
  @@unique([farmId, observedAt], name: "farm_satellite_observation_unique")
  @@index([farmId, observedAt(sort: Desc)])
  @@index([productId])
  @@map("satellite_observations")
}

model NdviObservation {
  id                     String               @id @default(uuid()) @db.Uuid
  farmId                 String               @db.Uuid
  satelliteObservationId String               @unique @db.Uuid
  observedAt             DateTime             @db.Timestamptz(6)
  meanNdvi               Decimal              @db.Decimal(5, 4)
  minNdvi                Decimal              @db.Decimal(5, 4)
  maxNdvi                Decimal              @db.Decimal(5, 4)
  validPixelPercentage   Decimal              @db.Decimal(5, 2)
  createdAt              DateTime             @default(now())

  // Relationships
  farm                   Farm                 @relation(fields: [farmId], references: [id], onDelete: Cascade)
  satelliteObservation   SatelliteObservation @relation(fields: [satelliteObservationId], references: [id], onDelete: Cascade)

  @@unique([farmId, observedAt], name: "farm_ndvi_observation_unique")
  @@index([farmId, observedAt(sort: Desc)])
  @@map("ndvi_observations")
}

// ============================================================================
// Module 8: Machine Learning Risk Prediction & Explainability Domain
// ============================================================================

model MlRiskPrediction {
  id                     String   @id @default(uuid()) @db.Uuid
  farmId                 String   @db.Uuid
  assessedAt             DateTime @db.Timestamptz(6)
  inputFingerprint       String   @db.VarChar(64)
  predictedClass         Int      @db.Integer
  calibratedProbability  Decimal  @db.Decimal(6, 5)
  rawDecisionMargin      Decimal  @db.Decimal(10, 5)
  featureSnapshot        Json     @db.JsonB
  shapExplanation        Json     @db.JsonB
  modelName              String   @db.VarChar(100)
  modelVersion           String   @db.VarChar(50)
  featureContractVersion String   @db.VarChar(20)
  disclaimer             String   @db.Text
  createdAt              DateTime @default(now()) @db.Timestamptz(6)

  // Relationships
  farm                   Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)

  @@index([farmId, assessedAt(sort: Desc)])
  @@index([farmId, inputFingerprint])
  @@index([assessedAt])
  @@map("ml_risk_predictions")
}

// ============================================================================
// Module 9: Parametric Underwriting, Policy & Automated Claims Domain
// ============================================================================

enum PolicyStatus {
  PENDING
  ACTIVE
  EXPIRED
  EXHAUSTED
  CANCELLED
}

enum ClaimStatus {
  PENDING
  APPROVED
  PAID
  REJECTED
}

model Policy {
  id                   String           @id @default(uuid()) @db.Uuid
  policyNumber         String           @unique @db.VarChar(50)
  farmId               String           @db.Uuid
  farmerId             String           @db.Uuid
  cropName             String           @db.VarChar(100)
  sumInsured           Decimal          @db.Decimal(12, 2)
  premiumAmount        Decimal          @db.Decimal(12, 2)
  coveredHazards       RiskHazardType[]
  startDate            DateTime         @db.Timestamptz(6)
  endDate              DateTime         @db.Timestamptz(6)
  cumulativePaidAmount Decimal          @default(0.00) @db.Decimal(12, 2)
  status               PolicyStatus     @default(PENDING)
  createdAt            DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime         @updatedAt @db.Timestamptz(6)

  // Relationships
  farm                 Farm             @relation(fields: [farmId], references: [id], onDelete: Restrict)
  farmer               Farmer           @relation(fields: [farmerId], references: [id], onDelete: Restrict)
  claims               Claim[]

  @@index([farmId, status])
  @@index([farmerId])
  @@index([status])
  @@index([startDate, endDate])
  @@map("policies")
}

model Claim {
  id               String         @id @default(uuid()) @db.Uuid
  claimNumber      String         @unique @db.VarChar(50)
  policyId         String         @db.Uuid
  assessmentId     String         @db.Uuid
  riskEventId      String         @db.Uuid
  triggerRuleCode  String         @db.VarChar(50)
  severity         RiskSeverity
  observedValue    Decimal?       @db.Decimal(10, 2)
  thresholdValue   Decimal        @db.Decimal(10, 2)
  payoutAmount     Decimal        @db.Decimal(12, 2)
  status           ClaimStatus    @default(PENDING)
  rejectionReason  String?        @db.Text
  payoutReference  String?        @db.VarChar(100)
  paidAt           DateTime?      @db.Timestamptz(6)
  createdAt        DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime       @updatedAt @db.Timestamptz(6)

  // Relationships
  policy           Policy         @relation(fields: [policyId], references: [id], onDelete: Restrict)
  assessment       RiskAssessment @relation(fields: [assessmentId], references: [id], onDelete: Restrict)
  riskEvent        RiskEvent      @relation(fields: [riskEventId], references: [id], onDelete: Restrict)

  // Database-level duplicate-claim protection: a policy can have at most one claim per RiskEvent
  @@unique([policyId, riskEventId], name: "policy_risk_event_unique")
  @@index([policyId, createdAt(sort: Desc)])
  @@index([assessmentId])
  @@index([riskEventId])
  @@index([status])
  @@map("claims")
}
