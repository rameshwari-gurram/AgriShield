// AgriShield Parametric - Prisma Schema
// Module 3: Farm Management Domain

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Language {
  en // English
  hi // Hindi
  mr // Marathi
  te // Telugu
  ta // Tamil
  kn // Kannada
  gu // Gujarati
  bn // Bengali
  pa // Punjabi
}

enum AreaUnit {
  ACRE
  HECTARE
  BIGHA
  GUNTHA
}

enum FarmStatus {
  ACTIVE
  INACTIVE
  HARVESTED
}

model Farmer {
  id                    String    @id @default(uuid()) @db.Uuid
  fullName              String    @db.VarChar(100)
  mobileNumber          String    @unique @db.VarChar(15)
  preferredLanguage     Language  @default(en)
  farmerReferenceNumber String?   @unique @db.VarChar(50)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // Relationships
  farms                 Farm[]

  @@index([farmerReferenceNumber])
  @@map("farmers")
}

model Farm {
  id                  String      @id @default(uuid()) @db.Uuid
  farmerId            String      @db.Uuid
  farmName            String      @db.VarChar(100)
  farmReferenceNumber String      @unique @db.VarChar(50)
  cropName            String      @db.VarChar(100)
  cropVariety         String?     @db.VarChar(100)
  sowingDate          DateTime    @db.Date
  expectedHarvestDate DateTime?   @db.Date
  farmArea            Decimal     @db.Decimal(10, 2)
  farmAreaUnit        AreaUnit    @default(ACRE)
  village             String      @db.VarChar(100)
  district            String      @db.VarChar(100)
  state               String      @db.VarChar(100)
  pincode             String      @db.VarChar(6)
  status              FarmStatus  @default(ACTIVE)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  // Relationships
  farmer              Farmer         @relation(fields: [farmerId], references: [id], onDelete: Restrict)
  boundary            FarmBoundary?

  @@index([farmerId])
  @@index([cropName])
  @@index([state, district])
  @@map("farms")
}

model FarmBoundary {
  id                     String      @id @default(uuid()) @db.Uuid
  farmId                 String      @unique @db.Uuid
  geom                   Unsupported("geometry(Polygon, 4326)")
  calculatedAreaSqM      Decimal     @db.Decimal(14, 2)
  calculatedAreaHectares Decimal     @db.Decimal(10, 4)
  calculatedAreaAcres    Decimal     @db.Decimal(10, 4)
  centroidLatitude       Decimal     @db.Decimal(9, 6)
  centroidLongitude      Decimal     @db.Decimal(9, 6)
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt

  // Relationships
  farm                   Farm        @relation(fields: [farmId], references: [id], onDelete: Cascade)

  @@index([geom], type: Gist)
  @@map("farm_boundaries")
}

