// AgriShield Parametric - Prisma Schema
// Module 2: PostgreSQL Database Foundation + Farmer Management

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Language {
  en // English
  hi // Hindi
  mr // Marathi
  te // Telugu
  ta // Tamil
  kn // Kannada
  gu // Gujarati
  bn // Bengali
  pa // Punjabi
}

model Farmer {
  id                    String    @id @default(uuid()) @db.Uuid
  fullName              String    @db.VarChar(100)
  mobileNumber          String    @unique @db.VarChar(15)
  preferredLanguage     Language  @default(en)
  farmerReferenceNumber String?   @unique @db.VarChar(50)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([farmerReferenceNumber])
  @@map("farmers")
}
